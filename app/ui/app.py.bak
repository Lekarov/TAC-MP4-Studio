        self._slider_row(self._vinyl_opts, "Largeur",     self.vinyl_rim_width, 0.0, 10.0)
        self._slider_row(self._vinyl_opts, "IntensitÃ©",   self.vinyl_rim_base,  0.0, 1.0)
        self._slider_row(self._vinyl_opts, "RÃ©activitÃ©",  self.vinyl_rim_gain,  0.0, 2.0)

        self._refresh_vinyl_opts()

        _sep(ti)
        ctk.CTkLabel(ti, text="Fond", text_color=MUTED, font=FONT_MU, anchor="w").pack(anchor="w", pady=(8, 2))
