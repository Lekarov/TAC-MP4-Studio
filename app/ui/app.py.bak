        self._slider_row(self._vinyl_opts, "Anneau",    self.vinyl_label_sep_ring, 0.0, 1.0)
        self._slider_row(self._vinyl_opts, "Pulse px",  self.vinyl_label_pulse_px, 0,   8,   fmt=".0f")

        # Reflet spÃ©culaire
        ctk.CTkLabel(self._vinyl_opts, text="Reflet", text_color=MUTED,
                     font=FONT_MU, anchor="w").pack(anchor="w", pady=(8, 0))
        self._slider_row(self._vinyl_opts, "Arc Â°",    self.vinyl_refl_arc_deg, 5,   180)
        self._slider_row(self._vinyl_opts, "OpacitÃ©",  self.vinyl_refl_opacity, 0.0, 1.0)
        self._slider_row(self._vinyl_opts, "Flash",    self.vinyl_refl_flash,   0.0, 2.0)

        # Ombre
        ctk.CTkLabel(self._vinyl_opts, text="Ombre", text_color=MUTED,
                     font=FONT_MU, anchor="w").pack(anchor="w", pady=(8, 0))
        self._slider_row(self._vinyl_opts, "Flou base", self.vinyl_shadow_blur_base,   0, 40,  fmt=".0f")
        self._slider_row(self._vinyl_opts, "Flou kick", self.vinyl_shadow_blur_gain,   0, 120, fmt=".0f")
        self._slider_row(self._vinyl_opts, "OpacitÃ©",   self.vinyl_shadow_opacity,     0.0, 1.0)
        self._slider_row(self._vinyl_opts, "Seuil kick",self.vinyl_shadow_kick_thresh, 0.0, 1.0)

        # Bordure (rim light)
