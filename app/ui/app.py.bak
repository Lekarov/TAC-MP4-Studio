        for val, label in [("photo", "ðŸ“· Photo floue"), ("gradient", "ðŸŒˆ DÃ©gradÃ©"), ("custom", "ðŸ“‚ Image perso")]:
            ctk.CTkRadioButton(mr, text=label, variable=self.bg_mode, value=val,
