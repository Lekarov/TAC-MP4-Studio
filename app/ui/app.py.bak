        ctk.CTkFrame(te, height=4, fg_color=ACCGLOW, corner_radius=4).pack(
            fill="x", pady=(2, 0))

        # Tout est construit â€” retirer le masque et rafraÃ®chir en une seule passe
        self.main.update_idletasks()
        try:
            _build_cover.destroy()
        except Exception:
            pass
        self.main.update_idletasks()

        self._prepare_preview()

