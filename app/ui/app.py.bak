        _fi.pack(fill="x", padx=10, pady=(10, 10))

        for icon, name_fn, change_fn in [
            ("ðŸŽµ", self._short_name(self.audio_path), self.show_step_audio),
            ("ðŸ–¼", self._short_name(self.image_path), self.show_step_image),
        ]:
            _row = ctk.CTkFrame(_fi, fg_color="transparent")
            _row.pack(fill="x", pady=(0, 4))
