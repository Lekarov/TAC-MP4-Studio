        # â”€â”€ ðŸš€ Export â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        te = mkscroll("ðŸš€")
        ctk.CTkLabel(te, text="Dossier de sortie", text_color=MUTED, font=FONT_MU, anchor="w").pack(anchor="w", pady=(8, 2))
        rr = ctk.CTkFrame(te, fg_color="transparent")
