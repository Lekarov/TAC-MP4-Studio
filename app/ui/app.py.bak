        self._shadow_swatch.pack(side="left", padx=(8, 6))
        self._shadow_swatch.pack_propagate(False)
        self._shadow_hex_lbl = ctk.CTkLabel(_sh_row, text=self.shadow_color, text_color=TEXT2,
                                             font=FONT_MONO, width=65, anchor="w")
