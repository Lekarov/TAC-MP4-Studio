def _init_fonts():
    global FONT_H1, FONT_H2, FONT_SEC, FONT_SM, FONT_MU, FONT_MONO
    FONT_H1  = ctk.CTkFont(family="Segoe UI", size=20, weight="bold")
    FONT_H2  = ctk.CTkFont(family="Segoe UI", size=12, weight="bold")
    FONT_SEC = ctk.CTkFont(family="Segoe UI", size=10, weight="bold")
    FONT_SM  = ctk.CTkFont(family="Segoe UI", size=10)
    FONT_MU  = ctk.CTkFont(family="Segoe UI", size=9)
    FONT_MONO = ctk.CTkFont(family="Consolas", size=9)


def _btn(parent, text, command, accent=False, danger=False, small=False,
         ghost=False, **kw):
    if accent:
        defaults = {
            "fg_color": ACCENT, "hover_color": ACCHOV,
            "text_color": "#ffffff",
            "font": FONT_H2 if not small else FONT_SM,
            "corner_radius": 10,
            "border_width": 0,
        }
    elif danger:
        defaults = {
            "fg_color": "#2d1520", "hover_color": "#3d1f2a",
            "text_color": DANGER,
            "font": FONT_SM,
            "corner_radius": 8,
            "border_color": "#5c2535", "border_width": 1,
        }
    elif ghost:
        defaults = {
            "fg_color": "transparent", "hover_color": SURF3,
            "text_color": TEXT2,
            "font": FONT_SM,
            "corner_radius": 8,
            "border_color": BORDER2, "border_width": 1,
        }
    else:
        defaults = {
            "fg_color": SURF3, "hover_color": "#20202e",
            "text_color": TEXT,
            "font": FONT_SM,
            "corner_radius": 8,
            "border_color": BORDER, "border_width": 1,
        }
    defaults.update(kw)
    return ctk.CTkButton(parent, text=text, command=command, **defaults)


def _card(parent, **kw):
    return ctk.CTkFrame(parent, fg_color=SURF2, corner_radius=12,
                        border_color=BORDER, border_width=1, **kw)


def _sep(parent):
    ctk.CTkFrame(parent, height=1, fg_color=BORDER, corner_radius=0).pack(
        fill="x", padx=8, pady=(10, 2))


# â”€â”€ Tooltip simple â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

class _Tooltip:
    """Tooltip minimaliste â€” apparaÃ®t aprÃ¨s 500ms, disparaÃ®t au Leave."""

    NAMES = {
        "âš¡": "Presets",
        "ðŸŽµ": "Ambiance Â· Vinyle Â· Texte",
        "ðŸŽ¨": "Fond Â· DÃ©gradÃ© Â· Flottant",
        "ðŸ“Š": "Spectre Â· Couleur",
        "ðŸš€": "Export",
    }

    def __init__(self, widget: tk.Widget, text: str) -> None:
        self._widget = widget
        self._text   = text
        self._tip: tk.Toplevel | None = None
        self._job: str | None = None
        widget.bind("<Enter>", self._schedule, add="+")
        widget.bind("<Leave>", self._cancel,   add="+")

    def _schedule(self, _=None) -> None:
        self._cancel()
        self._job = self._widget.after(500, self._show)

    def _cancel(self, _=None) -> None:
        if self._job:
            self._widget.after_cancel(self._job)
            self._job = None
        if self._tip:
            try:
                self._tip.destroy()
            except Exception:
                pass
            self._tip = None

    def _show(self) -> None:
        x = self._widget.winfo_rootx() + self._widget.winfo_width() // 2
        y = self._widget.winfo_rooty() + self._widget.winfo_height() + 4
        self._tip = tk.Toplevel(self._widget)
        self._tip.wm_overrideredirect(True)
        self._tip.configure(bg="#1e1e1e")
        tk.Label(self._tip, text=self._text, bg="#1e1e1e", fg="#e4e4e7",
                 font=("Segoe UI", 9), padx=10, pady=5,
                 relief="flat").pack()
        self._tip.wm_geometry(f"+{x - 60}+{y}")


