        _btn(_sh_row, "Choisir", self._pick_shadow_color, ghost=True, small=True, width=70, height=26).pack(side="left", padx=(6, 0))
        self._slider_row(tt, "DÃ©calage X", self.shadow_offset_x, 0.0, 20.0)
        self._slider_row(tt, "DÃ©calage Y", self.shadow_offset_y, 0.0, 20.0)

        # â”€â”€ ðŸ“Š Spectre â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        ts = mkscroll("ðŸ“Š")
        self._combo_row(ts, "Style", self.spectrum_style, SPECTRUM_STYLES)
        _sep(ts)
        self._slider_row(ts, "Taille",     self.spectrum_size, 0.55, 1.65)
        self._slider_row(ts, "Position Y", self.spectrum_y,   0.62, 0.95)
        _sep(ts)
        ctk.CTkLabel(ts, text="Couleur principale", text_color=TEXT2, font=FONT_MU, anchor="w").pack(anchor="w", pady=(8, 2))
        cr = ctk.CTkFrame(ts, fg_color="transparent")
        cr.pack(fill="x", pady=(0, 4))
        self._spec_swatch = ctk.CTkFrame(cr, width=24, height=24, corner_radius=6,
                                         fg_color=self.spectrum_color)
        self._spec_swatch.pack(side="left", padx=(0, 8))
        self._spec_swatch.pack_propagate(False)
        self._spec_hex_lbl = ctk.CTkLabel(cr, text=self.spectrum_color,
                                           text_color=TEXT2, font=FONT_MONO, width=70, anchor="w")
        self._spec_hex_lbl.pack(side="left")
        _btn(cr, "Choisir", self._pick_spectrum_color, ghost=True, small=True, width=70, height=26).pack(side="left", padx=(6, 0))
        _btn(cr, "â¬œ", lambda: self._set_spectrum_color("#ffffff"), ghost=True, small=True, width=36, height=26).pack(side="left", padx=(4, 0))
        ar = ctk.CTkFrame(ts, fg_color="transparent")
        ar.pack(fill="x", pady=(0, 4))
        ctk.CTkLabel(ar, text="Auto depuis pochette", text_color=MUTED, font=FONT_MU, anchor="w").pack(side="left")
        ctk.CTkSwitch(ar, text="", variable=self.spectrum_color_auto,
                      command=self._on_spectrum_color_auto,
                      progress_color=ACCENT, button_color=ACCLT,
                      button_hover_color=ACCENT, width=44, height=22).pack(side="right")

        # â”€â”€ Update 7 â€” Spectre 3 couleurs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        _sep(ts)
        tri_hdr = ctk.CTkFrame(ts, fg_color="transparent")
        tri_hdr.pack(fill="x", pady=(8, 2))
        ctk.CTkLabel(tri_hdr, text="ðŸŽ¨  Mode 3 couleurs", text_color=TEXT,
                     font=FONT_H2, anchor="w").pack(side="left")
        ctk.CTkSwitch(tri_hdr, text="", variable=self.spectrum_tricolor,
                      command=self._on_tricolor_changed,
                      progress_color=ACCENT, button_color=ACCLT,
                      button_hover_color=ACCENT, width=44, height=22).pack(side="right")
        ctk.CTkLabel(ts, text="Grave â†’ MÃ©diums â†’ Aigus, chaque bande a sa couleur",
                     text_color=MUTED, font=FONT_MU, anchor="w").pack(anchor="w", pady=(0, 6))

        # Color pickers mid + high â€” cachÃ©s si tricolor OFF
        self._tricolor_frame = ctk.CTkFrame(ts, fg_color="transparent")
        self._tricolor_frame.pack(fill="x", pady=(0, 4))
        for attr, label, swatch_attr, hex_attr, pick_fn, reset_fn in [
            ("spectrum_color_mid",  "MÃ©diums (centre)",
             "_spec_swatch_mid",  "_spec_hex_mid",
             lambda: self._pick_spectrum_color_band("mid"),
             lambda: self._set_spectrum_color_band("mid", "#ffffff")),
            ("spectrum_color_high", "Aigus (droite)",
             "_spec_swatch_high", "_spec_hex_high",
             lambda: self._pick_spectrum_color_band("high"),
             lambda: self._set_spectrum_color_band("high", "#ffffff")),
        ]:
            ctk.CTkLabel(self._tricolor_frame, text=label, text_color=TEXT2,
                         font=FONT_MU, anchor="w").pack(anchor="w", pady=(4, 2))
            row = ctk.CTkFrame(self._tricolor_frame, fg_color="transparent")
            row.pack(fill="x", pady=(0, 4))
            color_val = getattr(self, attr)
            sw = ctk.CTkFrame(row, width=24, height=24, corner_radius=6, fg_color=color_val)
            sw.pack(side="left", padx=(0, 8))
            sw.pack_propagate(False)
            hl = ctk.CTkLabel(row, text=color_val, text_color=TEXT2, font=FONT_MONO, width=70, anchor="w")
            hl.pack(side="left")
            setattr(self, swatch_attr, sw)
            setattr(self, hex_attr, hl)
            _btn(row, "Choisir", pick_fn, ghost=True, small=True, width=70, height=26).pack(side="left", padx=(6, 0))
            _btn(row, "â¬œ", reset_fn, ghost=True, small=True, width=36, height=26).pack(side="left", padx=(4, 0))
        self._refresh_tricolor_opts()

        # Mode rÃ©actif
        react_row = ctk.CTkFrame(ts, fg_color="transparent")
        react_row.pack(fill="x", pady=(6, 0))
        ctk.CTkLabel(react_row, text="âš¡  Flash sur les beats", text_color=TEXT,
                     font=FONT_H2, anchor="w").pack(side="left")
        ctk.CTkSwitch(react_row, text="", variable=self.spectrum_reactive,
                      command=self._on_setting_changed,
                      progress_color=ACCENT, button_color=ACCLT,
                      button_hover_color=ACCENT, width=44, height=22).pack(side="right")
        ctk.CTkLabel(ts, text="Le spectre flashe blanc sur chaque kick",
