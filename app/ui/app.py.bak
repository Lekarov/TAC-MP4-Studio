                             "9:16 â†’ 16:9" if self.preview_is_vertical else "16:9 â†’ 9:16",
                             self._toggle_preview_format,
                             ghost=True, height=32, small=True,
                             fg_color=ACCENT if self.preview_is_vertical else "transparent",
                             hover_color=ACCHOV if self.preview_is_vertical else SURF3)
        self._fmt_btn.pack(side="right", padx=(6, 0))
        _btn(ctrl, "â† Accueil", self.show_home,
             ghost=True, height=32, small=True).pack(side="right", padx=(0, 6))

        # â”€â”€ Panneau droit : Fichiers (fixe) + TabView â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

